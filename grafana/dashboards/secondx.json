    },
    {
      "type": "table",
      "title": "Top consumers - average over selected range",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "secondx-influx"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"secondx_process\" and r._field == \"value\")\n  |> filter(fn: (r) => contains(value: r.host, set: ${host:json}))\n  |> group(columns: [\"host\", \"process\", \"metric\"])\n  |> mean()\n  |> group()\n  |> pivot(rowKey: [\"host\", \"process\"], columnKey: [\"metric\"], valueColumn: \"_value\")\n  |> sort(columns: [\"cpu\"], desc: true)"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "cpu",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cpu"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ram"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "disk_read"
            },
            "properties": [
              {
                "id": "unit",
                "value": "KBs"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "disk_write"
            },
            "properties": [
              {
                "id": "unit",
                "value": "KBs"
              }
            ]
          }
        ]
