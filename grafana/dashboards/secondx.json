            "uid": "secondx-influx"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"secondx_system\" and (r._field == \"disk_read_kbps\" or r._field == \"disk_write_kbps\" or r._field == \"net_sent_kbps\" or r._field == \"net_recv_kbps\"))\n  |> filter(fn: (r) => contains(value: r.host, set: ${host:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
