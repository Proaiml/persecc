# Copy to ".env" and change EVERY value before "docker compose up -d".
# The same INFLUXDB_TOKEN goes into SecondX (config.json "influx.token" or SECONDX_INFLUX_TOKEN).

INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-min-8-chars
INFLUXDB_ORG=secondx
INFLUXDB_BUCKET=secondx
# How long raw per-second data is kept (e.g. 7d, 30d, 90d)
INFLUXDB_RETENTION=30d
# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
INFLUXDB_TOKEN=change-me-to-a-long-random-token

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
